# Copia este archivo como ".env" y ajusta los valores según tu entorno local.
# El archivo ".env" NO debe subirse al repositorio (ver .gitignore).

# Carpeta donde el backend busca el archivo Excel de datos (.xls o .xlsx)
DATA_FOLDER=data

# Host y puerto donde corre el servidor Flask
HOST=0.0.0.0
PORT=5000

# Modo debug de Flask (recarga automática + trazas de error detalladas)
# Usar "True" solo en desarrollo local, nunca en producción
FLASK_DEBUG=False
